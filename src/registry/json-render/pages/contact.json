{
  "root": "page",
  "elements": {
    "page": {
      "type": "Stack",
      "props": {},
      "children": ["nav", "contact", "faqs", "footer"]
    },
    "nav": {
      "type": "TopNavigation5",
      "props": {
        "logoSrc": "/logo.svg",
        "logoAlt": "Lumen",
        "homeHref": "/",
        "links": [
          {
            "label": "Features",
            "href": "/features"
          },
          {
            "label": "Pricing",
            "href": "/pricing"
          },
          {
            "label": "About",
            "href": "/about"
          },
          {
            "label": "Contact",
            "href": "/contact",
            "active": true
          }
        ],
        "actionLabel": "Sign in"
      },
      "children": [],
      "on": {
        "action": {
          "action": "signIn",
          "params": {}
        }
      }
    },
    "contact": {
      "type": "Contact11",
      "props": {
        "tagline": "Contact",
        "heading": "Talk to our team",
        "description": "Tell us about your team and we'll get back to you within one business day.",
        "nameLabel": "Name",
        "namePlaceholder": "Your name",
        "emailLabel": "Work email",
        "emailPlaceholder": "you@company.com",
        "messageLabel": "How can we help?",
        "messagePlaceholder": "Tell us about your team",
        "consentText": "I agree to the",
        "privacyLabel": "Privacy Policy",
        "privacyHref": "/privacy",
        "submitLabel": "Send message",
        "values": {
          "$bindState": "/contact"
        }
      },
      "children": [],
      "on": {
        "submit": {
          "action": "sendContact",
          "params": {
            "values": {
              "$state": "/contact"
            }
          }
        }
      }
    },
    "faqs": {
      "type": "FAQs4",
      "props": {
        "tagline": "FAQ",
        "heading": "Questions, answered",
        "items": [
          {
            "question": "How long does setup take?",
            "answer": "Most teams connect their tools and see their first dashboard within an hour."
          },
          {
            "question": "Can I cancel anytime?",
            "answer": "Yes. Plans are month to month and you can cancel from your account settings."
          },
          {
            "question": "Do you offer discounts for nonprofits?",
            "answer": "Yes, registered nonprofits get 50% off any plan. Contact us to apply."
          },
          {
            "question": "How quickly do you reply?",
            "answer": "Within one business day, usually sooner. Enterprise customers get a dedicated channel."
          }
        ],
        "supportText": "",
        "supportLinkLabel": "",
        "supportLinkHref": "/contact"
      },
      "children": []
    },
    "footer": {
      "type": "Footer4",
      "props": {
        "logoSrc": "/logo.svg",
        "logoAlt": "Lumen",
        "homeHref": "/",
        "description": "Delivery insights for engineering teams.",
        "social": [
          {
            "platform": "linkedin",
            "href": "https://www.linkedin.com/company/example"
          },
          {
            "platform": "x",
            "href": "https://x.com/example"
          }
        ],
        "columns": [
