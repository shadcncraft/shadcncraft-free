              },
              {
                "label": "Pricing",
                "href": "/pricing"
              },
              {
                "label": "Changelog",
                "href": "/changelog"
              }
            ]
          },
          {
            "title": "Company",
            "links": [
              {
                "label": "About",
                "href": "/about"
              },
              {
                "label": "Careers",
                "href": "/careers"
              },
              {
                "label": "Contact",
                "href": "/contact"
              }
            ]
          },
          {
            "title": "Legal",
