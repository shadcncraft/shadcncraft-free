    "page": {
      "type": "Stack",
      "props": {},
      "children": ["nav", "team", "testimonials", "newsletter", "footer"]
    },
    "nav": {
      "type": "TopNavigation5",
      "props": {
        "logoSrc": "/logo.svg",
